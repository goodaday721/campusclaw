# ===== MySQL（db 服务与 api 服务共用同一组凭据）=====
DB_HOST=db
DB_PORT=3306
# 必填：业务数据库名
DB_NAME=campusclaw
# 必填：业务账号
DB_USER=app
# 必填：业务账号密码——真实值只写进本地 .env，勿提交版本库
DB_PASSWORD=change-me
# 必填：MySQL root 密码（db 容器首次初始化 + 容器内跑测试用）
DB_ROOT_PASSWORD=change-me-root

# ===== api（Flask）=====
SESSION_TTL_HOURS=24
SESSION_COOKIE_NAME=session_id
UPLOAD_MAX_SIZE_MB=50
# 容器内上传根目录（对应 compose 挂载 ./uploads:/app/uploads）
UPLOAD_ROOT=/app/uploads
# api 容器内部监听端口（仅 Compose 内网可见，一般无需改动）
PORT=5000

# ===== web（Nginx）=====
# 宿主机访问端口：http://localhost:8080
WEB_PORT=8080

# ===== Qdrant 向量库（第 4 课，仅 Compose 内网，不映射宿主机端口）=====
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=campusclaw_chunks

# ===== 模型网关（OpenAI 兼容接口，仅服务端调用，密钥绝不下发浏览器）=====
# 课程网关地址；留空时 keyword 关键字检索仍可用，vector/hybrid/问答返回 503
EMBED_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# 必填（使用向量检索/问答时）：嵌入接口密钥——只填进本地 .env
EMBED_API_KEY=
# 嵌入模型名（以课程网关上实际可用的模型为准）
EMBED_MODEL=
# 对话（问答）网关，多数情况下与嵌入网关同址
CHAT_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
# 必填（使用问答时）：对话接口密钥——只填进本地 .env
CHAT_API_KEY=
# 对话模型名（以课程网关上实际可用的模型为准）
CHAT_MODEL=
# 网关超时（秒）
GATEWAY_TIMEOUT_CONNECT=5
GATEWAY_TIMEOUT_READ=30

# ===== 检索参数（课件固定值，一般无需改动）=====
RETRIEVAL_VECTOR_THRESHOLD=0.35
RRF_K=60
SEARCH_PATH_LIMIT=20
SEARCH_FINAL_LIMIT=10
ASK_TOP_K=4
EXCERPT_LIMIT=200
